
(module colors mzscheme
  (define BlueColor "blue")
  (define RedColor "red")
  (define GreenColor "lime green")
  (define YellowColor "yellow")
  (define PinkColor "pink")
  (define OrangeColor "orange")
  (define PurpleColor "purple")

  (provide BlueColor
	   RedColor
	   GreenColor
	   YellowColor
	   PinkColor
	   OrangeColor
	   PurpleColor))

