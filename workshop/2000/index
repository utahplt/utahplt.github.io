#!/bin/sh
string=? ; exec mzscheme -g -l core.ss -r $0 "$@"

(load "contents")

;; --------------------------------------------------------------------------

(define (make-html)
  (printf HEADER "Workshop Program")
  (printf TABLE-HEAD)
  (for-each process-day schedule)
  (printf TABLE-FOOT)
  (printf FOOTER))

(define (process-day list3)
  (let* ((day (car list3))
	 (morning (cadr list3))
	 (afternoon (caddr list3))
	 (mo-le (length morning))
	 (af-le (length afternoon))
	 (blanks (build-list (abs (- mo-le af-le)) (lambda (x) "  ")))
	 (morning (if (>= mo-le af-le) morning (append morning blanks)))
	 (afternoon (if (>= af-le mo-le) afternoon (append afternoon blanks))))
    (printf DAY day)
    (process-part morning day 'morning)
    (process-part afternoon day 'afternoon)
    (printf "</tr>~n~n")))

(define (process-part sch day part)
  (printf "<td valign=top>~n")
  (for-each (lambda (x) (printf "  ~a<br>~n" x)) sch)
  (printf TO-DETAILS
          HAND:IMG (format "~a-~a.html" day part)
          HAND:IMG (format "~a-~a-lab.html" day part))
  (print-details day part)
  (printf "</td>~n"))

(define (print-details day part)
  (let* ((title (format "Details for ~a ~a" day part))
	 (lab-title (format "LAB for ~a ~a" day part))
	 (base:str (format "~a-~a" day part))
	 (tit:sym (string->symbol base:str))
	 (file:str (string-append base:str ".html"))
	 (lab:str (string-append base:str "-lab"))
	 (lab-file (string-append lab:str ".html"))
	 (lab:sym (string->symbol lab:str)))
    (with-handlers ((exn? (lambda (x)
			    ;; this catches non-existing details/labs
			    (display (exn-message x))
			    (newline)
			    #t)))
      (fprintf (remove-and-open file:str)
	       DETAILS
	       title (eval tit:sym) HAND:IMG lab-file DATE)
      (fprintf (remove-and-open lab-file)
	       LAB
	       lab-title (eval lab:sym) DATE)
      )))

